# Ace: private ZDOTDIR. Restore the user's ZDOTDIR first so every other rc file is read from the real place.
if [[ -n "${ACE_ZDOTDIR_ORIG+X}" ]]; then
  export ZDOTDIR="$ACE_ZDOTDIR_ORIG"
else
  unset ZDOTDIR
fi
unset ACE_ZDOTDIR_ORIG
[[ -f "${ZDOTDIR:-$HOME}/.zshenv" ]] && source "${ZDOTDIR:-$HOME}/.zshenv"
source "$ACE_SHELL_INTEGRATION_DIR/ace.zsh"
