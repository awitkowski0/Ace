# Atelier: bash rcfile. Emulates a login shell (the real profile files are only read, never changed), then adds the integration.
if [ -z "$ATELIER_BASH_NOLOGIN" ]; then
  [ -r /etc/profile ] && . /etc/profile
  for __f in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
    if [ -r "$__f" ]; then . "$__f"; break; fi
  done
  unset __f
fi
if [ -n "$ATELIER_SHELL_INTEGRATION" ] && [ -z "$__atelier_loaded" ]; then
  __atelier_loaded=1
  __atelier_urlenc() {
    local LC_ALL=C s=$1 i c out=
    for ((i = 0; i < ${#s}; i++)); do
      c=${s:i:1}
      case $c in
        [a-zA-Z0-9/._~-]) out+=$c ;;
        *) printf -v c '%%%02X' "'$c"; out+=$c ;;
      esac
    done
    printf %s "$out"
  }
  __atelier_precmd() {
    local ret=$?
    printf '\e]133;D;%s\a' "$ret"
    printf '\e]7;file://%s%s\a' "${HOSTNAME}" "$(__atelier_urlenc "$PWD")"
    printf '\e]2;%s\a' "${PWD/#$HOME/\~}"
    case $PS1 in
      *'133;A'*) ;;
      *) PS1='\[\e]133;A\a\]'"$PS1"'\[\e]133;B\a\]' ;;
    esac
    return $ret
  }
  # PS0 (bash >= 4.4) is printed right before a command runs: that is our "output starts" mark.
  PS0='\e]133;C\a'"${PS0-}"
  if [[ "$(declare -p PROMPT_COMMAND 2>/dev/null)" == "declare -a"* ]]; then
    PROMPT_COMMAND=(__atelier_precmd "${PROMPT_COMMAND[@]}")
  else
    PROMPT_COMMAND="__atelier_precmd${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
  fi
fi
